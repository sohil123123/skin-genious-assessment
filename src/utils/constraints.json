{
  "defined_by": "Dr.Aakriti Mehra",
  "description": "Clinical , Products & machine constraints for AI Aesthetics skincare and facial treatment plan generation. All treatment plans must comply with these rules. No procedure, product, or device beyond the listed items should be suggested. The treatment engine has FULL FREEDOM to choose ANY sequence of steps or customize different steps for different facial zones, as long as the two mandatory finishing requirements are met.",

  "clinical_constraints": {
    "patient_history_rules": [
      {
        "condition": "age_between_30_and_60",
        "rule": "Include HiFU treatment only when clinically indicated and if patient age is between 30 and 60 years (inclusive)."
      },
      {
        "condition": "sun_exposure_gt_2_hours",
        "rule": "If daily sun exposure is greater than 2 hours, avoid Q-Switch Laser and all medium or deep chemical peels."
      },
      {
        "condition": "sun_exposure_1_to_2_hours",
        "rule": "If daily sun exposure is between 1 and 2 hours, avoid all deep chemical peels."
      },
      {
        "condition": "travel_within_7_days",
        "rule": "If the patient plans to travel within the next 7 days, avoid Q-Switch Laser and deep chemical peels."
      },
      {
        "condition": "social_event_within_7_days",
        "rule": "If the patient has a social event within the next 7 days, avoid Q-Switch Laser and deep chemical peels."
      },
      {
        "condition": "diabetes",
        "rule": "If patient has diabetes, look for link between the condition and Acanthotic patches/pigmentation and provide improvement outlook accordingly."
      },
      {
        "condition": "thyroid",
        "rule": "If patient has thyroid issues, look for link between the condition and melasma/pigmentation and provide improvement outlook accordingly."
      },
      {
        "condition": "PCOD",
        "rule": "In case patient has PCOD, keep it in mind while suggesting improvement levels in any active acne."
      },
      {
        "condition": "on_blood_thinners",
        "rule": "If the patient is on blood thinners, do only gentle exfoliation."
      },
      {
        "condition": "used_salicylic_yesterday",
        "rule": "If the patient has used Salicylic Acid on the previous day, avoid deep peels and Q-Switch Laser."
      },
      {
        "condition": "used_glycolic_acid_yesterday",
        "rule": "If the patient has used Glycolic Acid on the previous day, avoid deep peels and Q-Switch Laser."
      },
      {
        "condition": "aloe_vera_allergy",
        "rule": "If the patient has Aloe Vera allergy, skip all treatments or products containing Aloe Vera."
      },
      {
        "condition": "vitamin_c_allergy",
        "rule": "If the patient has Vitamin C allergy, skip all treatments or products containing Vitamin C."
      },
      {
        "condition": "pregnant",
        "rule": "If patient is pregnant, allow use of only hydrafacial machine in machines and only party peel and pumpkin peel within Peels. Avoid LED light therapy, Q-Switch, and medium/deep peels."
      },
      {
        "condition": "breastfeeding",
        "rule": "If the patient is breastfeeding, avoid retinol-based peels and products."
      }
    ],

    "general_treatment_rules": [
      {
        "rule": "Every facial treatment must finish (last step of treatment) with Serum + Moisturizer + Sunscreen."
      },
      {
        "rule": "Add a face massage and lymphatic drainage massage wherever possible."
      },
      {
        "rule": "There is NO fixed or recommended sequence for treatment steps. The LLM is free to design ANY sequence or use DIFFERENT treatments for different facial zones based on scoring, diagnosis, and clinical logic."
      }
    ]
  },

