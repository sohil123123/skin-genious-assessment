{
  "engine": "AI_IV_ClinicalScoring",
  "version": "2.2-aligned-intake_passthrough_normalized_severity_sensitive",
  "defined_by": "AI Aesthetics Clinical Team",

  "design_principles": {
    "separation_of_concerns": "This layer produces ONLY interpretable physiology/skin-readiness scores + evidence + passthrough. No ingredient/volume/rate recommendations. No hard-stops; those live in constraints.",
    "mece": true,
    "continuous_over_trigger": "Prefer continuous mapping (0..1 -> 0..100) over point-add triggers. Triggers only for caps/guards.",
    "patient_perception_aligned": "Each axis blends (a) symptom-perceived burden and (b) device/biomarker burden. Symptom SEVERITY is supported to align with real-world perception and day-to-day change.",
    "downstream_readiness": "Expose raw + normalized evidence so treatment + constraints can make nuanced choices even when axis scores are close.",
    "passthrough_policy": "Never drop intake fields. If the intake spec adds fields, this scoring layer should still accept + pass them through without needing schema changes elsewhere.",
    "primitives_policy": "Skin AI primitives are optional refiners (small, capped adjustments) and are always passed through as evidence when present.",
    "change_sensitivity": "Mappings are calibrated to show measurable improvement when patients report symptom relief and when objective vitals/machine metrics shift within plausible short-term ranges."
  },

  "score_scale": {
    "range": "0-100",
    "direction": "0=low need/low burden, 100=high need/high burden",
    "rounding": "nearest_integer"
  },

  "helpers": {
    "clip01": "clip(x,0,1)",
    "pwlin": "pwlin(x,x0,x1)=clip((x-x0)/(x1-x0),0,1)",
    "inv_pwlin": "inv_pwlin(x,x0,x1)=1-clip((x-x0)/(x1-x0),0,1)",
    "to100": "to100(x01)=round(100*clip(x01,0,1))",
    "safe_div": "safe_div(a,b)=a/(b+0.001)",
    "bool01": "bool01(flag)=flag?1:0",
    "sev01": "sev01(x)= ((x=='none'||x=='None'||x=='NONE')?0:((x=='mild'||x=='Mild'||x=='MILD')?0.33:((x=='moderate'||x=='Moderate'||x=='MODERATE')?0.66:((x=='severe'||x=='Severe'||x=='SEVERE')?1.0:0))))",
    "safe_num": "safe_num(x,default)=if_null(x,default)"
  },

  "inputs_contract": {
    "required": {
      "session_intake_raw": {
        "demographics": { "age_years": "number", "sex": "male|female" },

        "goals_and_intent": {
          "primary_goal": "Energy|Skin glow|Recovery|Immunity support|Brain fog|Athletic performance|Antioxidant|NAD+ wellness|Weight Management & Metabolism|Stress Relief & Relaxation",
          "secondary_goal_optional": "same_enum_or_null",
          "desired_intensity_preference": "Gentle|Moderate|Strong"
        },

        "safety_and_contraindications": "object_full_v1_1_as_collected (kept verbatim; scoring does not gate)",

        "lifestyle_last_24h": {
          "sleep_hours_last_night": "number",
          "caffeine_servings_today": "number",
          "alcohol_category_last_24h": "None|1-2|3-5|>5",
          "exercise_category_last_24h": "None|Light|Heavy",
          "perceived_stress_level_optional": "Low|Medium|High|null"
        },

        "symptoms": {
          "fatigue_severity": "none|mild|moderate|severe",

          "brain_fog_present": "boolean",

          "headache_severity": "none|mild|moderate|severe",

          "nausea_severity": "none|mild|moderate|severe",

          "vomiting_today_optional": "boolean_or_null",

          "dizziness_on_standing_present": "boolean",

          "muscle_cramps_present": "boolean",

          "palpitations_present": "boolean",

          "chest_pain_or_sob_right_now_optional": "boolean_or_null",

          "palpitations_timing_optional": "Occasional only|Happening now|null",

          "swelling_or_puffiness_present": "boolean",

          "shortness_of_breath_present": "boolean",

          "constipation_or_sluggish_digestion_today": "boolean",

          "constipation_type_optional": "true_constipation|sluggishness|null"
        },

        "iv_access_tolerance_optional": "object_full_v1_1_as_collected (kept verbatim)",

        "nad_specific_optional": "object_full_v1_1_as_collected (kept verbatim)"
      },

      "session_machines_raw": {
        "vitals": {
          "systolic_bp_mmHg": "number",

          "diastolic_bp_mmHg": "number",

          "heart_rate_bpm": "number",

          "heart_rate_bp_device_bpm_optional": "number_or_null",

          "heart_rate_oximeter_bpm_optional": "number_or_null",

          "spo2_percent": "number_or_null",

          "respiratory_rate_bpm_optional": "number_or_null",

          "systemic_temperature_c_optional": "number_or_null",

          "facial_temps_c_optional": {
            "forehead_surface_c": "number_or_null",

            "left_cheek_surface_c": "number_or_null",

            "right_cheek_surface_c": "number_or_null"
          }
        },

        "body_composition": {
          "weight_kg_optional": "number_or_null",

          "height_cm_optional": "number_or_null",

          "bmi_optional": "number_or_null",

          "tbw_percent": "number_or_null",

          "body_fat_percent_optional": "number_or_null",
          "__alias_optional_fat_percent__deprecated": "If input contains optional_fat_percent, treat it as body_fat_percent_optional for backward compatibility.",

          "muscle_mass_kg_optional": "number_or_null",

          "visceral_fat_rating": "number",

          "bmr_kcal_optional": "number_or_null",

          "optional_lean_mass_kg": "number_or_null"
        },

        "perfusion_index": { "pi": "number_or_null" },

        "hrv": {
          "rmssd_ms_optional": "number_or_null",

          "lnrmssd_optional": "number_or_null",

          "resting_heart_rate_bpm_optional": "number_or_null",

          "measurement_duration_minutes_optional": "number_or_null"
        },

        "orthostatic_optional": {
          "seated_systolic_bp_mmHg_optional": "number_or_null",

          "seated_diastolic_bp_mmHg_optional": "number_or_null",

          "seated_heart_rate_bpm_optional": "number_or_null",

          "standing_systolic_bp_mmHg_optional": "number_or_null",

          "standing_diastolic_bp_mmHg_optional": "number_or_null",

          "standing_heart_rate_bpm_optional": "number_or_null"
        },

        "grip_strength": {
          "dominant_hand_kg_optional": "number_or_null",

          "non_dominant_hand_kg_optional": "number_or_null",

          "kg_optional": "number_or_null"
        }
      },

      "skin_ai_raw": {
        "scores": {
          "OSS": { "score_0_100": "integer_0_100" },
          "GMS": { "score_0_100": "integer_0_100" },
          "MVI": { "score_0_100": "integer_0_100" },
          "BHS": { "score_0_100": "integer_0_100" }
        },

        "optional_primitives": {
          "uv_haze_index_0_1": "number_or_null",

          "uv_fluorescence_load_0_1": "number_or_null",

          "uv_fluorescence_coverage_0_1": "number_or_null",

          "redness_level_0_1": "number_or_null",

          "redness_coverage_0_1": "number_or_null",

          "barrier_instability_0_1": "number_or_null",

          "dry_sink_fraction_0_1": "number_or_null",

          "texture_roughness_0_1": "number_or_null"
        },

        "telemetry_upstream_optional": {
          "roi_confidence_0_1": "number_or_null",
          "mode_calibration_ok": "boolean_or_null",
          "underexposed_flag": "boolean_or_null",
          "overexposed_flag": "boolean_or_null",
          "high_glare_flag": "boolean_or_null"
        },
        "confidence_0_1": "number_or_null"
      }
    },

    "optional": {
      "medications_and_flags": "object_optional_as_collected (kept verbatim; passed through)"
    }
  },

  "normalization_layer": {
    "goal_mapping_policy": "Preserve the original (human) goals, and also map them to a compact scoring enum for axis goal-alignment terms. Treatment engine should prefer the original goals; scoring uses the mapped goal.",
    "goals_normalized": {
      "primary_goal_raw": "session_intake_raw.goals_and_intent.primary_goal",
      "secondary_goal_raw_optional": "session_intake_raw.goals_and_intent.secondary_goal_optional",
      "desired_intensity_preference_raw": "session_intake_raw.goals_and_intent.desired_intensity_preference",

      "primary_goal_mapped_for_scoring": "map_goal(primary_goal_raw)",
      "secondary_goal_mapped_for_scoring_optional": "if_not_null(secondary_goal_raw_optional) ? map_goal(secondary_goal_raw_optional) : null",

      "map_goal_table": {
        "Energy": "energy",
        "Skin glow": "skin_glow",
        "Recovery": "recovery",
        "Immunity support": "immunity",
        "Brain fog": "energy",
        "Athletic performance": "performance",
        "Antioxidant": "detox",
        "NAD+ wellness": "energy",
        "Weight Management & Metabolism": "performance",
        "Stress Relief & Relaxation": "recovery"
      }
    },

    "lifestyle_normalized": {
      "sleep_hours_last_night": "session_intake_raw.lifestyle_last_24h.sleep_hours_last_night",
      "caffeine_servings_today": "session_intake_raw.lifestyle_last_24h.caffeine_servings_today",

      "alcohol_category_last_24h": "session_intake_raw.lifestyle_last_24h.alcohol_category_last_24h",
      "alcohol_drinks_estimated_last_24h": "alcohol_category_last_24h=='None'?0:(alcohol_category_last_24h=='1-2'?1.5:(alcohol_category_last_24h=='3-5'?4.0:6.5))",

      "exercise_category_last_24h": "session_intake_raw.lifestyle_last_24h.exercise_category_last_24h",
      "exercise_last_24h_mapped": "exercise_category_last_24h=='None'?'none':(exercise_category_last_24h=='Light'?'light':'intense')",

      "perceived_stress_level_optional": "session_intake_raw.lifestyle_last_24h.perceived_stress_level_optional",
      "perceived_stress_norm_0_1_optional": "if_not_null(perceived_stress_level_optional) ? (perceived_stress_level_optional=='Low'?0.15:(perceived_stress_level_optional=='Medium'?0.35:0.60)) : null"
    },

    "symptoms_normalized": {
      "fatigue_sev01": "sev01(session_intake_raw.symptoms.fatigue_severity)",
      "headache_sev01": "sev01(session_intake_raw.symptoms.headache_severity)",
      "nausea_sev01": "sev01(session_intake_raw.symptoms.nausea_severity)",

      "fatigue_bool": "fatigue_sev01>0 ? true : false",
      "headache_bool": "headache_sev01>0 ? true : false",
      "nausea_bool": "nausea_sev01>0 ? true : false",

      "brain_fog_bool": "session_intake_raw.symptoms.brain_fog_present",
      "dizziness_bool": "session_intake_raw.symptoms.dizziness_on_standing_present",
      "cramps_bool": "session_intake_raw.symptoms.muscle_cramps_present",
      "palpitations_bool": "session_intake_raw.symptoms.palpitations_present",
      "swelling_bool": "session_intake_raw.symptoms.swelling_or_puffiness_present",
      "sob_bool": "session_intake_raw.symptoms.shortness_of_breath_present",

      "constipation_bool": "session_intake_raw.symptoms.constipation_or_sluggish_digestion_today",
      "constipation_weight_0_1": "session_intake_raw.symptoms.constipation_or_sluggish_digestion_today==true ? (session_intake_raw.symptoms.constipation_type_optional=='true_constipation' ? 0.10 : 0.05) : 0.0"
    },

    "temperature_normalized": {
      "systemic_temperature_c_optional": "session_machines_raw.vitals.systemic_temperature_c_optional",
      "forehead_surface_c": "session_machines_raw.vitals.facial_temps_c_optional.forehead_surface_c",
      "left_cheek_surface_c": "session_machines_raw.vitals.facial_temps_c_optional.left_cheek_surface_c",
      "right_cheek_surface_c": "session_machines_raw.vitals.facial_temps_c_optional.right_cheek_surface_c",

      "avg_facial_surface_temp_c_optional": "if_not_null(forehead_surface_c) && if_not_null(left_cheek_surface_c) && if_not_null(right_cheek_surface_c) ? (forehead_surface_c+left_cheek_surface_c+right_cheek_surface_c)/3 : (if_not_null(forehead_surface_c)?forehead_surface_c:null)",

      "temperature_c_for_scoring": "if_not_null(systemic_temperature_c_optional) ? systemic_temperature_c_optional : safe_num(avg_facial_surface_temp_c_optional, 36.6)"
    },

    "hrv_normalized": {
      "rmssd_ms_optional": "session_machines_raw.hrv.rmssd_ms_optional",
      "lnrmssd_optional": "session_machines_raw.hrv.lnrmssd_optional",
      "lnrmssd_derived_optional": "if_not_null(lnrmssd_optional) ? lnrmssd_optional : (if_not_null(rmssd_ms_optional) ? ln(rmssd_ms_optional) : null)"
    }
  },

  "scoring_inputs_view": {
    "demographics": "session_intake_raw.demographics",
    "goals_scoring": {
      "primary_goal_mapped": "normalization_layer.goals_normalized.primary_goal_mapped_for_scoring",
      "secondary_goal_mapped_optional": "normalization_layer.goals_normalized.secondary_goal_mapped_for_scoring_optional"
    },
    "vitals_scoring": {
      "systolic_bp_mmHg": "session_machines_raw.vitals.systolic_bp_mmHg",
      "diastolic_bp_mmHg": "session_machines_raw.vitals.diastolic_bp_mmHg",
      "heart_rate_bpm": "session_machines_raw.vitals.heart_rate_bpm",
      "spo2_percent": "safe_num(session_machines_raw.vitals.spo2_percent, 98)",
      "temperature_c": "normalization_layer.temperature_normalized.temperature_c_for_scoring"
    },
    "lifestyle_scoring": {
      "sleep_hours_last_night": "normalization_layer.lifestyle_normalized.sleep_hours_last_night",
      "caffeine_servings_today": "normalization_layer.lifestyle_normalized.caffeine_servings_today",
      "alcohol_drinks_last_24h": "normalization_layer.lifestyle_normalized.alcohol_drinks_estimated_last_24h",
      "exercise_last_24h": "normalization_layer.lifestyle_normalized.exercise_last_24h_mapped",
      "perceived_stress_norm_0_1_optional": "normalization_layer.lifestyle_normalized.perceived_stress_norm_0_1_optional"
    },
    "symptoms_scoring": {
      "fatigue_sev01": "normalization_layer.symptoms_normalized.fatigue_sev01",
      "headache_sev01": "normalization_layer.symptoms_normalized.headache_sev01",
      "nausea_sev01": "normalization_layer.symptoms_normalized.nausea_sev01",
      "fatigue": "normalization_layer.symptoms_normalized.fatigue_bool",
      "brain_fog": "normalization_layer.symptoms_normalized.brain_fog_bool",
      "headache": "normalization_layer.symptoms_normalized.headache_bool",
      "nausea": "normalization_layer.symptoms_normalized.nausea_bool",
      "dizziness_on_standing": "normalization_layer.symptoms_normalized.dizziness_bool",
      "muscle_cramps": "normalization_layer.symptoms_normalized.cramps_bool",
      "palpitations": "normalization_layer.symptoms_normalized.palpitations_bool",
      "swelling_or_puffiness": "normalization_layer.symptoms_normalized.swelling_bool",
      "shortness_of_breath": "normalization_layer.symptoms_normalized.sob_bool",

      "constipation_or_sluggish_digestion_today": "normalization_layer.symptoms_normalized.constipation_bool",
      "constipation_weight_0_1": "normalization_layer.symptoms_normalized.constipation_weight_0_1"
    },
    "machines_scoring": {
      "body_composition": "session_machines_raw.body_composition",
      "perfusion_index": "session_machines_raw.perfusion_index",
      "hrv": { "lnrmssd_optional": "normalization_layer.hrv_normalized.lnrmssd_derived_optional" },
      "grip_strength": "session_machines_raw.grip_strength"
    },
    "skin_ai_scoring": {
      "OSS_0_100": "skin_ai_raw.scores.OSS.score_0_100",

      "GMS_0_100": "skin_ai_raw.scores.GMS.score_0_100",

      "MVI_0_100": "skin_ai_raw.scores.MVI.score_0_100",

      "BHS_0_100": "skin_ai_raw.scores.BHS.score_0_100",

      "optional_primitives_passthrough": "skin_ai_raw.optional_primitives",

      "telemetry_upstream_optional": "skin_ai_raw.telemetry_upstream_optional"
    }
  },




  "axes": {
    "FENS": {
      "name": "Fluid & Electrolyte Need Score",
      "clinical_question": "How much does the patient likely benefit from volume/electrolyte support today?"
    },
    "PCCS": {
      "name": "Perfusion & Circulation Constraint Score",
      "clinical_question": "How constrained is vascular delivery (sluggish flow, vasoconstriction, low PI)?"
    },
    "ASLS": {
      "name": "Autonomic Stress & Load Score",
      "clinical_question": "Is the patient in sympathetic load / low recovery state today?"
    },
    "MONS": {
      "name": "Mitochondrial Output Need Score",
      "clinical_question": "Is there functional fatigue/low output that may benefit from energy-supportive IV strategies?"
    },
    "ODS": {
      "name": "Oxidative / Detox Burden Score",
      "clinical_question": "Is oxidative burden high enough to warrant antioxidant-focused support (while respecting constraints)?"
    },
    "ILS": {
      "name": "Inflammation / Immune Load Score",
      "clinical_question": "Is there an inflammatory/immune burden likely to affect how aggressive we can be today?"
    },
    "MSGS": {
      "name": "Metabolic Stability / Glycation Stress Score",
      "clinical_question": "Is metabolic/glycation stress present that would influence ingredient selection/intensity?"
    },
    "DGS": {
      "name": "Dermal Glow / Barrier Support Score",
      "clinical_question": "How much does skin barrier + visible glow likely benefit from IV support today?"
    }
  },

  "downstream_readiness": {
    "why_scores_alone_are_not_enough": "Treatment prompt quality improves when it can see the drivers, raw intake choices, and normalized drivers — not only 8 integers.",

    "passthrough_raw_all": {
      "session_intake_raw": "session_intake_raw",
      "session_machines_raw": "session_machines_raw",
      "skin_ai_raw": "skin_ai_raw",
      "optional_medications_and_flags": "optional.medications_and_flags"
    },

    "passthrough_normalized_for_logic": {
      "goals_normalized": "normalization_layer.goals_normalized",
      "lifestyle_normalized": "normalization_layer.lifestyle_normalized",
      "symptoms_normalized": "normalization_layer.symptoms_normalized",
      "temperature_normalized": "normalization_layer.temperature_normalized",
      "hrv_normalized": "normalization_layer.hrv_normalized"
    },

    "evidence_minimal_used_by_scoring": {
      "goals_mapped_for_scoring": [
        "scoring_inputs_view.goals_scoring.primary_goal_mapped",
        "scoring_inputs_view.goals_scoring.secondary_goal_mapped_optional"
      ],
      "vitals_scoring": "scoring_inputs_view.vitals_scoring",
      "machines_scoring": "scoring_inputs_view.machines_scoring",
      "skin_ai_scoring": "scoring_inputs_view.skin_ai_scoring",
      "symptoms_scoring": "scoring_inputs_view.symptoms_scoring",
      "lifestyle_scoring": "scoring_inputs_view.lifestyle_scoring"
    }
  },
  "telemetry": {
    "note": "Telemetry drivers and confidence are pre-calculated by the deterministic scoring engine."
  },

  "integration_note_for_constraints_engine": {
    "constraints_engine_expects": "IV scoring output MUST be attached under the top-level key iv_scoring_output",
    "expected_location": "iv_scoring_output.scores_public_0_100",
    "do_not_break": [
      "constraints uses clinical_finding_path like iv_scoring_output.scores_public_0_100.PCCS",
      "keep session_intake_raw / session_machines_raw / skin_ai_raw as top-level containers alongside iv_scoring_output"
    ]
  },

  "output_contract": {
    "iv_scoring_output": {
      "scores_public_0_100": {
        "FENS": "integer_0_100",
        "PCCS": "integer_0_100",
        "ASLS": "integer_0_100",
        "MONS": "integer_0_100",
        "ODS": "integer_0_100",
        "ILS": "integer_0_100",
        "MSGS": "integer_0_100",
        "DGS": "integer_0_100"
      },

      "sub_indices_public_0_100": "object_per_axis_with_named_subindices",

      "passthrough_raw_all": "downstream_readiness.passthrough_raw_all",
      "passthrough_normalized_for_logic": "downstream_readiness.passthrough_normalized_for_logic",
      "evidence_minimal_used_by_scoring": "downstream_readiness.evidence_minimal_used_by_scoring",

      "telemetry": {
        "primary_driver_per_axis": "object",
        "confidence_0_1": "float_0_1",
        "confidence_detail_optional": "object (base/penalties/clamp) for explainability"
      }
    }
  },

  "runtime_return_shape_example": {
    "session_intake_raw": "verbatim input",
    "session_machines_raw": "verbatim input",
    "skin_ai_raw": "verbatim input",
    "iv_scoring_output": {
      "scores_public_0_100": {
        "FENS": 42,
        "PCCS": 61,
        "ASLS": 55,
        "MONS": 63,
        "ODS": 58,
        "ILS": 40,
        "MSGS": 52,
        "DGS": 67
      },
      "sub_indices_public_0_100": { "example": "..." },
      "passthrough_raw_all": { "example": "..." },
      "passthrough_normalized_for_logic": { "example": "..." },
      "evidence_minimal_used_by_scoring": { "example": "..." },
      "telemetry": {
        "primary_driver_per_axis": { "example": "..." },
        "confidence_0_1": 0.88,
        "confidence_detail_optional": {
          "base": 0.92,
          "penalties_applied_example": [
            { "note": "ANS confidence slightly lower without HRV", "subtract": 0.06 }
          ],
          "clamp": { "min": 0.1, "max": 0.95 }
        }
      }
    }
  }
}
