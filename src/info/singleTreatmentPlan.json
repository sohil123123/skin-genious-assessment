        "steps": [
          {
            "step_number": 1,
            "duration": "20",
            "ingredients_equipments": [
              "HydraFacial device (Ice probe)",
              "Oxygen infusion",
              "AS1 serum",
              "SA2 serum",
              "A03 serum"
            ],
            "how_to_do": "Perform cleansing and gentle exfoliation; engage Ice probe for cooling while initiating suction-based extraction; sequentially infuse AS1, SA2, and A03 serums via Hydrafacial head; apply oxygen infusion; monitor tolerance."
          },
          {
            "step_number": 2,
            "duration": "15",
            "ingredients_equipments": ["Gel Mandelic Peel", "Neutralizer"],
            "how_to_do": "Apply a thin, even layer of Gel Mandelic Peel to the entire face, avoiding eyes; leave 5–7 minutes; neutralize per product instructions; rinse with lukewarm water and pat dry."
          },
          {
            "step_number": 3,
            "duration": "10",
            "ingredients_equipments": ["RF lifting probe"],
            "how_to_do": "Perform 2–3 passes across the midface and jawline at low–moderate intensity; ensure full contact; monitor heat sensation; avoid excessive concentration on any one area."
          },
          {
            "step_number": 4,
            "duration": "12",
            "ingredients_equipments": ["LED panel (Blue + Red)"],
            "how_to_do": "Blue light for antibacterial/pores refinement for 6 minutes; Red light for collagen stimulation and anti-inflammatory effects for 6 minutes; maintain comfortable intensity."
          },
          {
            "step_number": 5,
            "duration": "7",
            "ingredients_equipments": ["Lymphatic drainage massage"],
            "how_to_do": "Perform gentle, upward and outward lymphatic strokes across the face, focusing on periorbital and cheek regions; 7 minutes total."
          },
          {
            "step_number": 6,
            "duration": "5",
            "ingredients_equipments": ["Serum", "Moisturizer", "Sunscreen"],
            "how_to_do": "Apply Hydrating serum (if provided), seal with moisturizer, and finish with broad-spectrum sunscreen; provide post-care instructions."
          }
        ]
      }
    ]
  },
