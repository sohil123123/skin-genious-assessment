        "smooth": "<0.2",
        "fine_flakes": "0.2–0.4",
        "coarse_flakes": "0.4–0.6",
        "scaling": ">0.6"
      }
    },

    "scores": [
      {
        "score": 0,
        "label": "No Sensitivity",
        "criteria": {
          "erythema_intensity_index": "<0.25",
          "barrier_uniformity_index": ">0.8"
        },
        "visual_flags": [
