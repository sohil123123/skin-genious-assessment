          {
            "step_number": 2,
            "duration": "25",
            "ingredients_equipments": [
              "Hydrafacial core treatment with Ice Probe",
              "Suction/Bubble Pen",
              "Ocular ultrasound infusion",
              "Face ultrasound infusion"
            ],
            "how_to_do": "Execute Hydrafacial core treatment: cleanse, exfo/peel, extraction, and infusion. Include an eye-area infusion using ocular ultrasound with soothing serums as tolerated. Monitor for any sensitivity."
          },
          {
            "step_number": 3,
            "duration": "5",
            "ingredients_equipments": ["Charcoal mask (Oily Skin)", "Mask brush"],
            "how_to_do": "Apply Charcoal mask to T-zone and other oily regions; allow 5 minutes for absorption; remove with gentle sponges."
          },
          {
            "step_number": 4,
            "duration": "7",
            "ingredients_equipments": [
              "Glyco Peel 35% or Salicylic 30% peel",
              "Neutralizer if needed"
            ],
            "how_to_do": "Apply a light Glyco 35% or Salicylic 30% peel to targeted areas for 1–2 minutes; monitor for tingling; neutralize as per product protocol. Do not apply to lips; avoid eyes."
          },
          {
            "step_number": 5,
            "duration": "10",
            "ingredients_equipments": [
              "Ocular ultrasound infusion serums (Vitamin C or Hyaluronic)",
              "Eye shields"
            ],
            "how_to_do": "Perform targeted ocular-area infusion to support periocular health; keep eyes shielded and monitor for discomfort."
          },
          {
            "step_number": 6,
            "duration": "12",
            "ingredients_equipments": [
              "Lymphatic drainage massage technique",
              "Light massage oil or gel"
            ],
            "how_to_do": "Perform gentle lymphatic drainage massage on face, neck, and décolletage in upward strokes. Focus on jawline, cheekbones, and periorbital regions to reduce puffiness and promote drainage."
          },
          {
            "step_number": 7,
            "duration": "7",
            "ingredients_equipments": [
              "Hydrating serum (Hyaluronic Acid)",
              "Moisturizer",
              "Sunscreen (SPF 30+)"
            ],
            "how_to_do": "Apply a hydrating serum, followed by a light moisturizer and broad-spectrum sunscreen. Ensure finish is comfortable and non-greasy."
          }
